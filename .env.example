# =============================================================================
# GrowthScope — example environment file
#
# Copy this file to `.env` and adjust the values:
#   cp .env.example .env            # macOS / Linux
#   Copy-Item .env.example .env     # Windows PowerShell
#
# NEVER commit real credentials, service-account keys or tokens.
# `.env` is gitignored; this example is safe to commit because it contains
# placeholders only.
#
# Prefer Application Default Credentials (ADC) — run once:
#   gcloud auth application-default login
# and leave GOOGLE_APPLICATION_CREDENTIALS unset. ADC keeps key files off disk.
# =============================================================================

# --- Google Cloud / BigQuery --------------------------------------------------

# The Google Cloud project that is BILLED for query bytes. The GA4 sample data
# itself is public; this value is only your billing/query project.
# Leave the placeholder if you only run local tests and do not query BigQuery.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Public dataset queried in Sprint 01 (GA4 obfuscated sample e-commerce export).
BQ_DATASET=bigquery-public-data.ga4_obfuscated_sample_ecommerce

# Cost guard: maximum bytes a single query is allowed to scan
# (BigQuery `maximum_bytes_billed`). 2,000,000,000 bytes ~= 2 GB — deliberately
# small: the BigQuery Sandbox free tier allows 1 TB of querying per month, and
# queries above this limit fail fast instead of silently consuming quota.
BQ_MAX_BYTES_BILLED=2000000000

# Optional path to a service-account JSON key. Prefer ADC (see header) and keep
# this commented out — never commit a real path or key.
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json

# --- Analysis window ----------------------------------------------------------

# Sprint 01 explores a deliberately small slice of the sample export
# (the dataset covers 2020-11-01 .. 2021-01-31). Fewer days = fewer bytes
# scanned = lower risk.
GA4_START_DATE=2020-11-01
GA4_END_DATE=2020-11-03

# --- Runtime ------------------------------------------------------------------

# GrowthScope runtime mode: `local` for developer machines and notebooks.
# Additional values (e.g. `ci`) are reserved for later sprints; nothing
# depends on them yet.
GROWTHSCOPE_ENV=local

# Notebook execution mode for notebooks/01_data_discovery.ipynb:
#   auto    (default) - live if credentials exist, else data/sample/, else blocked
#   live              - force BigQuery execution; fails loudly without credentials
#   sample            - force reading pre-fetched aggregates from data/sample/
#   blocked           - produce no results at all (used for the committed outputs)
#   demo              - run on clearly labelled SYNTHETIC teaching data; never results
# `blocked` and `demo` exist so the notebook is reviewable without a Google account.
GROWTHSCOPE_NOTEBOOK_MODE=auto

# Set to 1 to write aggregate result sets from a live run into data/sample/.
# Aggregates only: raw user-level events are never exported or committed.
GROWTHSCOPE_EXPORT_SAMPLE=0
